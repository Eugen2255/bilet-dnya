# Local Docker Compose only. Use different credentials on a shared server.
POSTGRES_DB=bilet
POSTGRES_USER=bilet
POSTGRES_PASSWORD=bilet_local
POSTGRES_PORT=5433
DATABASE_URL=postgresql://bilet:bilet_local@db:5432/bilet

TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# Used by native Python runs. Docker Compose mounts a private shared volume instead.
IMPORT_STORAGE=data/uploads
# Full OpenAI-compatible chat completions URL, for example https://openwebui.example.edu/api/chat/completions
MODEL_PRIMARY_URL=
MODEL_PRIMARY_ID=
MODEL_PRIMARY_API_KEY=
MODEL_REVIEW_ID=
MODEL_FALLBACK_URL=
MODEL_FALLBACK_ID=
MODEL_FALLBACK_API_KEY=
